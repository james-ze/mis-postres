rules_version = '2';
// Quién puede entrar y qué se puede hacer con los datos.
//
// Quién entra: las cuentas de Google cuyo correo (en minúsculas) esté en la lista de
// correosPermitidos(), o que tengan un documento en la colección "acceso" con su correo
// en minúsculas como ID. Este repositorio es público, así que aquí la lista va vacía: en la
// consola de Firebase se pegan estas mismas reglas con los correos reales en la lista.
service cloud.firestore {
  match /databases/{database}/documents {
    function correosPermitidos() {
      return [];
    }
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email.lower() in correosPermitidos()
          || exists(/databases/$(database)/documents/acceso/$(request.auth.token.email.lower())));
    }
    function coleccionValida(c) {
      return c in ['catalogo', 'clientes', 'rondas', 'pedidos', 'gastos', 'config'];
    }

    match /acceso/{correo} {
      allow read, write: if false;
    }

    // Los datos del negocio: se pueden leer, crear y cambiar, pero NUNCA borrar.
    // "Eliminar" en la app solo los manda a la papelera.
    match /negocios/{negocio}/{col}/{id} {
      allow read: if permitido() && (coleccionValida(col) || col == 'historial');
      allow create, update: if permitido() && coleccionValida(col)
        && request.resource.data.keys().hasAll(['_borrado', '_actualizado'])
        && request.resource.data._borrado is bool;
      allow delete: if false;
    }

    // El historial de cambios solo crece: no se puede editar ni borrar.
    match /negocios/{negocio}/historial/{id} {
      allow create: if permitido();
      allow update, delete: if false;
    }
  }
}
